      DTS:DTSID="{8B5B6C27-C396-40E2-A352-F03CB4E8E87A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST data de stgaing --&gt; DW_universite"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E56B572A-55F2-43A5-A438-FBE53B975645}"
          SQLTask:SqlStatementSource="DELETE FROM fact_examens;&#xA;&#xA;INSERT INTO fact_examens (&#xA;    SK_Etudiant,&#xA;    SK_Cours,&#xA;    SK_Date,&#xA;    SK_Reussite,&#xA;    id_examen,&#xA;    note,&#xA;    reussi&#xA;)&#xA;SELECT&#xA;    e.SK_Etudiant,&#xA;    c.SK_Cours,&#xA;    d.SK_Date,&#xA;    CASE&#xA;        WHEN s.note &gt;= 16 THEN 1&#xA;        WHEN s.note &gt;= 12 THEN 2&#xA;        WHEN s.note &gt;= 10 THEN 3&#xA;        ELSE 4&#xA;    END,&#xA;    s.id_exam,&#xA;    s.note,&#xA;    s.reussi&#xA;FROM DW_Universite_Staging.dbo.STG_Examens s&#xA;INNER JOIN dim_etudiant e ON s.id_etu = e.id_etudiant&#xA;INNER JOIN dim_cours c ON s.id_cours = c.id_cours&#xA;INNER JOIN dim_date d ON s.date_exam = d.date_complete&#xA;WHERE s.note IS NOT NULL&#xA;  AND s.id_etu IS NOT NULL&#xA;  AND s.id_cours IS NOT NULL&#xA;  AND s.date_exam IS NOT NULL;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
