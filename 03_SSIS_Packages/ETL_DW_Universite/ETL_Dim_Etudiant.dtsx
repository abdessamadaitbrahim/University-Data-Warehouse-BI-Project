      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E56B572A-55F2-43A5-A438-FBE53B975645}"
          SQLTask:SqlStatementSource="DELETE FROM fact_examens;&#xA;DELETE FROM dim_etudiant;&#xA;DBCC CHECKIDENT ('dim_etudiant', RESEED, 0);&#xA;INSERT INTO dim_etudiant (id_etudiant, nom, sexe, age, categorie_age)&#xA;SELECT &#xA;    id_etu, &#xA;    nom, &#xA;    sexe, &#xA;    age, &#xA;    categorie_age&#xA;FROM (&#xA;    SELECT &#xA;        id_etu, &#xA;        nom, &#xA;        sexe, &#xA;        age, &#xA;        categorie_age,&#xA;        ROW_NUMBER() OVER (PARTITION BY id_etu ORDER BY nom) as rn&#xA;    FROM DW_Universite_Staging.dbo.STG_Etudiants&#xA;) t&#xA;WHERE rn = 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
