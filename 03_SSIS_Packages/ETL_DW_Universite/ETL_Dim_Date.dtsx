         */
    }

    public override void CreateNewOutputRows()
    {
        // Plage de dates : du 1er janvier 2022 au 31 d�cembre 2024
        DateTime startDate = new DateTime(2022, 1, 1);
        DateTime endDate = new DateTime(2024, 12, 31);

        // Culture pour les noms de mois en fran�ais
        System.Globalization.CultureInfo frenchCulture =
            new System.Globalization.CultureInfo("fr-FR");

        // Boucle sur chaque jour
        for (DateTime date = startDate; date <= endDate; date = date.AddDays(1))
        {
            // Ajoute une nouvelle ligne
            Output0Buffer.AddRow();

            // Remplit les colonnes
            Output0Buffer.datecomplete = date;
            Output0Buffer.annee = date.Year;
            Output0Buffer.mois = date.Month;

            // Calcul du trimestre : T1=1-3, T2=4-6, T3=7-9, T4=10-12
            Output0Buffer.trimestre = (date.Month - 1) / 3 + 1;

            // Nom du mois en fran�ais
            Output0Buffer.nommois = date.ToString("MMMM", frenchCulture);

            // Calcul du semestre acad�mique :
            // S1 = Septembre � Janvier (mois 9-12 et 1)
            // S2 = F�vrier � Juin (mois 2-6)
            // Juillet-Ao�t (7-8) : hors ann�e acad�mique, on les met en S2
            if (date.Month >= 9 || date.Month <= 1)
            {
                Output0Buffer.semestre = 1;  // S1
            }
            else
            {
                Output0Buffer.semestre = 2;  // S2
            }
        }
    }

}
